#!/bin/sh
# V AppRun: standalone CPython + site-packages inside the AppImage.
# Prefer bundled FFmpeg in usr/bin, falling back to the host's FFmpeg.
here="$(dirname "$(readlink -f "$0")")"
export PATH="$here/usr/bin:$PATH"
export PYTHONNOUSERSITE=1 PYTHONPATH="$here/usr/lib/voz"
# ponytail: no PYTHONHOME; standalone CPython finds its stdlib relative to its binary.
exec "$here/usr/python/bin/python3" -c 'import sys; from voz.interfaces.cli.main import main; sys.argv[0] = "v"; main()' "$@"
